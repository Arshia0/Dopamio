# Django
DJANGO_SECRET_KEY=replace-with-a-random-secret

# SMS is disabled by default for local development.
KAVE_NEGAR_ENABLE=false
KAVE_NEGAR_APIKEY=
KAVE_NEGAR_SENDER=
KAVE_NEGAR_RESETPASSWORD_TEMPLATE=
SMS_TIMEOUT=2

# Required only when using production.py
POSTGRES_DB=dopamio
POSTGRES_USER=dopamio
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000
